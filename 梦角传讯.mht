body.theme-white { --bg-gradient-1: #ffffff; --bg-gradient-2: #fafafa; --bg-gradient-3: #f5f5f5; --bg-gradient-4: #eeeeee; --text-primary: #1a1a1a; --text-secondary: #4a4a4a; --text-tertiary: #6a6a6a; --text-muted: #9a9a9a; --card-bg: rgba(255, 255, 255, 0.95); --card-bg-solid: rgba(255, 255, 255, 1); --card-border: rgba(0, 0, 0, 0.08); --card-shadow: 0 4px 16px rgba(0, 0, 0, 0.08); --card-shadow-hover: 0 6px 24px rgba(0, 0, 0, 0.12); --topbar-bg-1: rgba(255, 255, 255, 0.98); --topbar-bg-2: rgba(255, 255, 255, 0.9); --tabbar-bg: rgba(255, 255, 255, 0.95); --tabbar-border: rgba(0, 0, 0, 0.1); --icon-btn-bg: rgba(255, 255, 255, 0.9); --icon-btn-border: rgba(0, 0, 0, 0.1); --chat-page-bg: #ffffff; --input-bg: rgba(255, 255, 255, 0.95); --input-border: #e0e0e0; --bubble-mine-bg-1: #e8e8e8; --bubble-mine-bg-2: #d8d8d8; --bubble-mine-text: #1a1a1a; --bubble-their-bg: rgba(245, 245, 245, 0.95); --bubble-their-text: #1a1a1a; --bg-primary: #ffffff; --bg-secondary: #f8f8f8; --modal-bg: rgba(255, 255, 255, 0.98); --modal-overlay: rgba(0, 0, 0, 0.3); --accent-pink: #f472b6; --accent-blue: #60a5fa; --accent-gold: #fbbf24; --accent-green: #34d399; --highlight-bg: #fff3cd; --highlight-text: #856404; }

