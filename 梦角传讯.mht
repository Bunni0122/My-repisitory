.dice-container { perspective: 400px; width: 50px; height: 50px; transform-style: preserve-3d; }

.dice-cube { width: 44px; height: 44px; position: relative; transform-style: preserve-3d; will-change: transform; }

.dice-face { position: absolute; width: 44px; height: 44px; background: linear-gradient(135deg, rgb(255, 255, 255) 0%, rgb(245, 245, 245) 100%); border: 1.5px solid rgb(204, 204, 204); border-radius: 8px; display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr 1fr; padding: 4px; box-sizing: border-box; backface-visibility: hidden; box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 4px inset; }

.dice-face .dot { width: 7px; height: 7px; background: rgb(51, 51, 51); border-radius: 50%; place-self: center; box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 3px inset; }

.dice-face .dot.red { background: rgb(231, 76, 60); box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 3px inset; }

.dice-face.f1 { transform: translateZ(22px); }

.dice-face.f2 { transform: rotateY(180deg) translateZ(22px); }

.dice-face.f3 { transform: rotateY(90deg) translateZ(22px); }

.dice-face.f4 { transform: rotateY(-90deg) translateZ(22px); }

.dice-face.f5 { transform: rotateX(90deg) translateZ(22px); }

.dice-face.f6 { transform: rotateX(-90deg) translateZ(22px); }

.dice-cube.show-1 { transform: rotateX(0deg) rotateY(0deg); }

.dice-cube.show-2 { transform: rotateY(180deg); }

.dice-cube.show-3 { transform: rotateY(-90deg); }

.dice-cube.show-4 { transform: rotateY(90deg); }

.dice-cube.show-5 { transform: rotateX(-90deg); }

.dice-cube.show-6 { transform: rotateX(90deg); }

@keyframes diceRollAnim { 
  0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
  100% { transform: rotateX(1080deg) rotateY(1440deg) rotateZ(360deg); }
}

