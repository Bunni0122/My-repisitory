.radar-scan-line { position: absolute; top: 50%; left: 50%; width: 50%; height: 2px; transform-origin: left center; background: linear-gradient(90deg, rgba(0, 255, 150, 0.7), rgba(0, 255, 150, 0) 100%); animation: 2.5s linear 0s infinite normal none running radarScan; z-index: 2; }

.radar-scan-glow { position: absolute; top: 50%; left: 50%; width: 50%; height: 50%; transform-origin: 0px 0px; background: conic-gradient(from 0deg, rgba(0, 255, 150, 0.12) 0deg, transparent 40deg); animation: 2.5s linear 0s infinite normal none running radarScan; z-index: 1; }

