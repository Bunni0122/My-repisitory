.theme-picker-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 4px 0px; }

.theme-option { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 6px; border-radius: 12px; border: 2px solid transparent; cursor: pointer; transition: all 0.2s ease 0s; background: var(--card-bg); }

.theme-option:active { transform: scale(0.95); }

.theme-option.active { border-color: var(--text-secondary); box-shadow: 0 0 0 2px var(--text-tertiary); }

.theme-swatch { width: 32px; height: 32px; border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.12) 0px 2px 8px; }

.theme-label { font-size: calc(10px * var(--font-scale, 1)); color: var(--text-secondary); text-align: center; white-space: nowrap; }

* { margin: 0px; padding: 0px; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

body { font-family: system-ui, sans-serif; background: var(--chat-page-bg); min-height: 100vh; color: var(--text-primary); overflow-x: hidden; font-size: calc(14px * var(--font-scale, 1)); position: relative; }

.new-msg-popup { position: fixed; top: calc(12px + env(safe-area-inset-top)); left: 50%; transform: translateX(-50%) translateY(-150px); width: calc(100% - 24px); max-width: 440px; background: var(--card-bg); backdrop-filter: blur(4px); border: 1px solid var(--card-border); border-radius: 18px; padding: 12px 14px; display: flex; align-items: center; gap: 12px; cursor: pointer; z-index: 9999; box-shadow: rgba(124, 58, 237, 0.2) 0px 12px 40px, rgba(124, 58, 237, 0.1) 0px 4px 12px; opacity: 0; transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; pointer-events: none; user-select: none; }

.new-msg-popup::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent); border-radius: 18px 18px 0px 0px; }

.new-msg-popup.show { opacity: 1; transform: translateX(-50%) translateY(0px); pointer-events: auto; }

.new-msg-avatar { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, rgb(196, 181, 253), rgb(167, 139, 250)); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: calc(16px * var(--font-scale, 1)); overflow: hidden; flex-shrink: 0; box-shadow: rgba(167, 139, 250, 0.3) 0px 2px 8px; }

.new-msg-avatar.group { background: linear-gradient(135deg, rgb(249, 168, 212), rgb(244, 114, 182)); box-shadow: rgba(244, 114, 182, 0.3) 0px 2px 8px; }

.new-msg-avatar img { width: 100%; height: 100%; object-fit: cover; }

.new-msg-content { flex: 1 1 0%; min-width: 0px; }

.new-msg-name { font-size: calc(14px * var(--font-scale, 1)); font-weight: 600; color: var(--text-primary); margin-bottom: 2px; display: flex; align-items: center; gap: 6px; }

.new-msg-badge { background: linear-gradient(135deg, rgb(244, 114, 182), rgb(236, 72, 153)); color: white; font-size: calc(10px * var(--font-scale, 1)); padding: 2px 8px; border-radius: 10px; line-height: 1.4; font-weight: 500; box-shadow: rgba(244, 114, 182, 0.3) 0px 2px 6px; }

.new-msg-text { font-size: calc(12px * var(--font-scale, 1)); color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.5; }

.new-msg-close { color: var(--text-muted); font-size: calc(18px * var(--font-scale, 1)); padding: 4px; cursor: pointer; flex-shrink: 0; line-height: 1; transition: color 0.2s ease 0s; }

.new-msg-close:active { color: var(--text-secondary); }

.context-menu { position: fixed; background: var(--modal-bg); border-radius: 16px; box-shadow: rgba(0, 0, 0, 0.18) 0px 8px 32px, rgba(0, 0, 0, 0.1) 0px 2px 8px; padding: 14px 10px 10px; z-index: 1000; width: 310px; border: 1px solid var(--card-border); display: none; backdrop-filter: blur(12px); }

.context-menu.active { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px 0px; animation: 0.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0s 1 normal none running menuFadeIn; }

@keyframes menuFadeIn { 
  0% { opacity: 0; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

.context-menu-item { padding: 10px 0px; font-size: calc(11px * var(--font-scale, 1)); color: var(--text-primary); cursor: pointer; border-radius: 10px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; transition: all 0.15s ease 0s; }

.context-menu-item:active { background: var(--card-bg); transform: scale(0.92); }

.context-menu-item.danger { color: rgb(239, 68, 68); }

.context-menu-item .menu-icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }

.context-menu-item .menu-icon svg { width: 24px; height: 24px; }

.context-menu-divider { grid-column: 1 / -1; height: 1px; background: var(--card-border); margin: 6px 4px; }

.page { display: none; min-height: 100vh; height: 100vh; overflow: hidden; }

.page.active { display: flex; flex-direction: column; animation: 0.2s ease 0s 1 normal none running fadeIn; }

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

#page-messages { padding-bottom: 70px; }

.chat-list { flex: 1 1 0%; padding: 10px 14px; overflow-y: auto; min-height: 0px; }

.tab-bar { position: fixed; bottom: 0px; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; height: 62px; background: var(--tabbar-bg); backdrop-filter: blur(4px); border-top: 1px solid var(--tabbar-border); display: flex; z-index: 100; padding-bottom: env(safe-area-inset-bottom); box-shadow: rgba(124, 58, 237, 0.08) 0px -4px 20px; }

.tab-bar::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent); }

.tab-item { flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; cursor: pointer; color: var(--text-tertiary); transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; font-size: calc(11px * var(--font-scale, 1)); position: relative; }

.tab-item.active { color: var(--text-secondary); transform: translateY(-2px); }

.tab-item.active .tab-icon { filter: drop-shadow(rgba(124, 58, 237, 0.3) 0px 2px 4px); }

.tab-icon { font-size: calc(24px * var(--font-scale, 1)); transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; }

.tab-item:active .tab-icon { transform: scale(0.9); }

.top-bar { display: flex; align-items: center; justify-content: space-between; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; padding-top: calc(16px + env(safe-area-inset-top)); position: sticky; top: 0px; z-index: 50; background: linear-gradient(180deg, var(--topbar-bg-1) 0%, var(--topbar-bg-2) 70%, transparent 100%); backdrop-filter: blur(6px); }

.top-bar-title { font-size: calc(18px * var(--font-scale, 1)); font-weight: 700; color: var(--text-primary); letter-spacing: 0.3px; }

.icon-btn { width: 38px; height: 38px; border-radius: 12px; background: var(--icon-btn-bg); border: 1px solid var(--icon-btn-border); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: calc(18px * var(--font-scale, 1)); transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; color: var(--text-secondary); box-shadow: rgba(124, 58, 237, 0.1) 0px 2px 8px; }

.icon-btn:active { transform: scale(0.92); box-shadow: rgba(124, 58, 237, 0.1) 0px 1px 4px; }

.icon-btn.primary { background: linear-gradient(135deg, var(--bubble-mine-bg-1) 0%, var(--bubble-mine-bg-2) 100%); color: var(--bubble-mine-text); border: none; box-shadow: rgba(139, 92, 246, 0.3) 0px 4px 12px; }

.icon-btn.primary:active { box-shadow: rgba(139, 92, 246, 0.2) 0px 2px 6px; }

.chat-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 16px; cursor: pointer; transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; margin-bottom: 10px; background: var(--card-bg); backdrop-filter: blur(6px); border: 1px solid var(--card-border); box-shadow: var(--card-shadow); position: relative; overflow: hidden; }

.chat-item::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent); }

.chat-item:active { transform: scale(0.98) translateY(1px); background: var(--card-bg-solid); box-shadow: rgba(124, 58, 237, 0.08) 0px 4px 16px; }

.chat-avatar { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; background: linear-gradient(135deg, rgb(196, 181, 253), rgb(167, 139, 250)); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: calc(18px * var(--font-scale, 1)); position: relative; overflow: hidden; box-shadow: rgba(167, 139, 250, 0.25) 0px 4px 12px; }

.chat-avatar.group { background: linear-gradient(135deg, rgb(249, 168, 212), rgb(244, 114, 182)); box-shadow: rgba(244, 114, 182, 0.25) 0px 4px 12px; }

.chat-avatar img { width: 100%; height: 100%; object-fit: cover; }

.chat-item-content { flex: 1 1 0%; min-width: 0px; }

.chat-item-name { font-size: calc(15px * var(--font-scale, 1)); font-weight: 600; color: var(--text-primary); margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }

.chat-item-preview { font-size: calc(13px * var(--font-scale, 1)); color: var(--text-secondary); opacity: 0.85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.4; }

.chat-item-time { font-size: calc(11px * var(--font-scale, 1)); color: var(--text-muted); flex-shrink: 0; align-self: flex-start; padding-top: 4px; }

.unread-badge { background: linear-gradient(135deg, rgb(244, 114, 182), rgb(236, 72, 153)); color: white; font-size: calc(10px * var(--font-scale, 1)); padding: 2px 8px; border-radius: 10px; min-width: 18px; text-align: center; font-weight: 600; box-shadow: rgba(244, 114, 182, 0.3) 0px 2px 6px; }

.group-tag { font-size: calc(10px * var(--font-scale, 1)); padding: 2px 8px; background: rgba(244, 114, 182, 0.15); color: var(--accent-pink); border-radius: 8px; font-weight: 500; }

.chat-page { display: none; position: fixed; inset: 0px; z-index: 200; flex-direction: column; background-color: var(--chat-page-bg); }

.chat-page.active { display: flex; animation: 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) 0s 1 normal none running slideInRight; }

@keyframes slideInRight { 
  0% { opacity: 0; transform: translateX(20px); }
  100% { opacity: 1; transform: translateX(0px); }
}

.chat-bg-layer { position: fixed; top: 0px; left: 0px; width: 100%; height: var(--app-window-height, 100vh); background-size: cover; background-position: center center; background-repeat: no-repeat; z-index: 0; pointer-events: none; }

.chat-page::before { content: ""; position: fixed; top: 0px; left: 0px; width: 100%; height: var(--app-window-height, 100vh); background: var(--chat-page-bg); z-index: 0; pointer-events: none; }

.chat-page { background-color: var(--chat-page-bg) !important; }

.chat-header { display: flex; align-items: center; padding-right: 4px; padding-bottom: 0px; padding-left: 4px; padding-top: calc(8px + env(safe-area-inset-top)); height: calc(44px + env(safe-area-inset-top)); background: var(--bg-primary); border-bottom: 1px solid var(--tabbar-border); position: relative; z-index: 1; }

.chat-header-back { font-size: calc(28px * var(--font-scale, 1)); color: var(--text-primary); cursor: pointer; padding: 4px 8px; flex-shrink: 0; line-height: 1; user-select: none; }

.chat-header-back:active { opacity: 0.5; }

.chat-header-title-wrap { flex: 1 1 0%; text-align: center; min-width: 0px; display: flex; align-items: center; justify-content: center; }

.companion-heart { font-size: calc(16px * var(--font-scale, 1)); margin-right: 4px; animation: 1.2s ease-in-out 0s infinite normal none running heartBeat; }

@keyframes heartBeat { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

.chat-header-name { font-size: calc(17px * var(--font-scale, 1)); font-weight: 600; color: rgb(0, 0, 0); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.chat-header-status { display: none; }

.chat-header-status.typing { display: inline; }

.chat-header-name.typing { font-size: calc(17px * var(--font-scale, 1)); font-weight: 400; color: rgb(0, 0, 0); }

.chat-header-name.typing .typing-dots { display: inline-block; margin-left: 2px; }

.chat-header-name.typing .typing-dots span { display: inline-block; width: 4px; height: 4px; background-color: rgb(153, 153, 153); border-radius: 50%; margin: 0px 1px; vertical-align: middle; animation: 1.4s ease-in-out 0s infinite normal both running typingDotBounce; }

.chat-header-name.typing .typing-dots span:nth-child(1) { animation-delay: -0.32s; }

.chat-header-name.typing .typing-dots span:nth-child(2) { animation-delay: -0.16s; }

.chat-header-name.typing .typing-dots span:nth-child(3) { animation-delay: 0s; }

@keyframes typingDotBounce { 
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.chat-header-more { font-size: calc(20px * var(--font-scale, 1)); color: var(--text-primary); cursor: pointer; padding: 4px 12px; flex-shrink: 0; letter-spacing: 2px; font-weight: bold; user-select: none; }

.chat-header-more:active { opacity: 0.5; }

.chat-header-avatar, .chat-header-info { display: none; }

@keyframes typingPulse { 
  0%, 100% { opacity: 1; }
