.radar-center-avatar { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 40px; height: 40px; border-radius: 50%; background: var(--accent-green, #10b981); display: flex; align-items: center; justify-content: center; overflow: hidden; z-index: 3; box-shadow: rgba(0, 255, 150, 0.5) 0px 0px 12px; border: 2px solid rgba(0, 255, 150, 0.6); }

