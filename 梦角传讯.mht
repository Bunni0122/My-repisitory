.radar-container { position: relative; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 255, 150, 0.06) 0%, rgba(0, 80, 60, 0.15) 60%, rgba(0, 40, 30, 0.3) 100%); box-shadow: rgba(0, 255, 150, 0.18) 0px 0px 50px, rgba(0, 255, 150, 0.06) 0px 0px 100px, rgba(0, 255, 150, 0.08) 0px 0px 70px inset; overflow: hidden; margin: 0px auto; }

